@namespace ChatApp.Core
@inject ChatApp.Core.Services.IVersionInfoProvider V

@if (info is null)
{
    <small style="color:#666;">Verzió betöltése…</small>
}
else
{
    <div style="font-size:12px; color:#666; line-height:1.3;">
        <div>Blazor Server • SQLite</div>
        <div>App @info.AppVersion @((!string.IsNullOrEmpty(info.Commit) ? $"({info.Commit})" : "")) • .NET @info.RuntimeVersion • @info.ProcessArchitecture</div>
        <div>EF: @info.EFProvider • Mig: @(info.LatestMigration ?? $"{info.AppliedMigrations} applied")</div>
        <div>SQLite: @(info.SqliteVersion ?? "?") • Env: @info.EnvironmentName</div>
    </div>
}

@code {
    private ChatApp.Core.Services.VersionInfo? info;

    protected override Task OnInitializedAsync()
    {
        info = V.Current; // already initialized at startup
        return Task.CompletedTask;
    }
}
