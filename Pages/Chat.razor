@page "/chat/{ChatId:int}"
@inject ChatApp.Services.ChatService ChatSvc
@inject NavigationManager Nav

<h1>@title</h1>

@if (loading)
{
    <p>Betöltés…</p>
}
else if (notFound)
{
    <p style="color:#b00020;">Nincs ilyen chat.</p>
}
else
{
<form @onsubmit="OnSendSubmit" @onsubmit:preventDefault>
    <div style="margin:1rem 0; display:flex; gap:0.5rem;">
        <input style="width:12rem;"
               @bind="draftSender"
               @bind:event="oninput"
               placeholder="Feladó" />

        <input style="flex:1;"
               @bind="draftText"
               @bind:event="oninput"
               placeholder="Üzenet…"
               @ref="messageInput" />

        <button type="submit" disabled="@(_sending || string.IsNullOrWhiteSpace(draftText))">
            Küldés
        </button>
    </div>
</form>

    <ul>
        @foreach (var m in messages)
        {
            <li style="margin-bottom:0.5rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                    <div style="flex:1;">
                        <div style="display:flex; justify-content:space-between;">
                            <strong>@m.Sender</strong>
                            <small>@m.SentAtUtc.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</small>
                        </div>
                        <div>@m.Text</div>
                    </div>
                    <button @onclick="(() => OnDeleteMessage(m.Id))" title="Törlés">🗑️</button>
                </div>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public int ChatId { get; set; }

    string title = "Chat";
    bool loading = true;
    bool notFound = false;

    List<ChatApp.Models.Message> messages = new();
    string draftSender = "User";
    string draftText = "";

    private HubConnection? hub;
    private int? currentJoinedChatId;
    private ElementReference messageInput;
    private bool _sending;

    private async Task OnSendSubmit()
    {
        if (_sending) return;
        if (string.IsNullOrWhiteSpace(draftText)) return;

        _sending = true;
        try
        {
            await SendMessage();
            await messageInput.FocusAsync();
        }
        finally { _sending = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Load data on parameter change
        await Load();
        // If hub already exists (after first render), ensure group membership reflects new ChatId
        if (hub is not null)
        {
            await JoinGroupIfNeededAsync(ChatId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnsureHubAsync();
            await JoinGroupIfNeededAsync(ChatId);
        }
    }

    async Task EnsureHubAsync()
    {
        if (hub is not null) return;
        hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        hub.On<ChatApp.Models.MessageDto>("MessageAdded", (dto) =>
        {
            if (dto.ChatId == ChatId)
            {
                _ = InvokeAsync(() =>
                {
                    if (!messages.Any(m => m.Id == dto.Id))
                    {
                        messages.Add(new ChatApp.Models.Message
                        {
                            Id = dto.Id,
                            ChatId = dto.ChatId,
                            Sender = dto.Sender,
                            Text = dto.Text,
                            SentAtUtc = dto.SentAtUtc
                        });
                    }
                    StateHasChanged();
                });
            }
        });

        // New: handle removals
        hub.On<int, int>("MessageRemoved", (chatId, messageId) =>
        {
            if (chatId == ChatId)
            {
                _ = InvokeAsync(() =>
                {
                    var idx = messages.FindIndex(x => x.Id == messageId);
                    if (idx >= 0)
                    {
                        messages.RemoveAt(idx);
                        StateHasChanged();
                    }
                });
            }
        });

        hub.Reconnected += async _ =>
        {
            if (currentJoinedChatId.HasValue)
            {
                try { await hub.InvokeAsync("JoinChat", currentJoinedChatId.Value); } catch { }
            }
        };

        if (hub.State != HubConnectionState.Connected)
        {
            await hub.StartAsync();
        }
    }

    async Task JoinGroupIfNeededAsync(int chatId)
    {
        if (hub is null) return;
        if (currentJoinedChatId == chatId) return;

        if (currentJoinedChatId.HasValue)
        {
            try { await hub.SendAsync("LeaveChat", currentJoinedChatId.Value); } catch { }
        }
        try
        {
            await hub.SendAsync("JoinChat", chatId);
            currentJoinedChatId = chatId;
        }
        catch
        {
            // swallow for now
        }
    }

    async Task Load()
    {
        loading = true;
        var chat = await ChatSvc.GetChatAsync(ChatId);
        if (chat is null) { notFound = true; loading = false; return; }
        title = chat.Title;

        messages = await ChatSvc.GetMessagesAsync(ChatId);
        loading = false;
    }

    async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(draftText)) return;
        await ChatSvc.SendMessageAsync(ChatId, draftSender, draftText);
        draftText = "";
        // rely on SignalR event to update both local and remote clients
    }

    // New: delete message handler
    async Task OnDeleteMessage(int messageId)
    {
        await ChatSvc.DeleteMessageAsync(ChatId, messageId);
        // immediate UI update happens via SignalR MessageRemoved event
    }

    public async ValueTask DisposeAsync()
    {
        if (hub is not null)
        {
            if (currentJoinedChatId.HasValue)
            {
                try { await hub.SendAsync("LeaveChat", currentJoinedChatId.Value); } catch { }
            }
            await hub.DisposeAsync();
        }
    }
}
